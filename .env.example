# Copie para .env.local (nunca commitado). Valores só lá.
# Neon, branch da fase (dev na migração; main depois da virada)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Dono do banco, com pooling: webhooks e cron (ignora RLS)
APP_DATABASE_URL=
# Papel app_auth_svc (neon/criar-papel-auth.sh grava esta)
APP_AUTH_DATABASE_URL=
# Better Auth: openssl rand -hex 32; URL pública da app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# URL da Data API da branch (pública: vai para o navegador)
VITE_DATA_API_URL=
