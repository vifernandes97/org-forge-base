# Copie para .env.local (nunca commitado). Valores só lá.
# Na VPS, os mesmos nomes vão no File mount /app/secrets.env do serviço app.
# Dono do banco (webhooks e cron; ignora RLS)
APP_DATABASE_URL=
# Papel app_auth_svc (db/criar-papeis.sh grava esta)
APP_AUTH_DATABASE_URL=
# Better Auth: openssl rand -hex 32; URL pública da app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# PostgREST: endereço interno e o segredo HS256 compartilhado com ele
# (openssl rand -hex 32). PGRST_DB_URI é do serviço do PostgREST, não do app.
PGRST_URL=
PGRST_JWT_SECRET=
PGRST_DB_URI=
