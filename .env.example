# Copie para .env.local (nunca commitado). Valores só lá.
# Na VPS, os mesmos nomes vão no File mount /app/secrets.env do serviço app.
# Dono do banco (webhooks e cron; ignora RLS)
APP_DATABASE_URL=
# Papel app_auth_svc (db/criar-papeis.sh grava esta)
APP_AUTH_DATABASE_URL=
# Better Auth: openssl rand -hex 32; URL pública da app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# PostgREST: endereço interno e o segredo HS256 compartilhado com ele
# (openssl rand -hex 32). PGRST_DB_URI é do serviço do PostgREST, não do app.
PGRST_URL=
PGRST_JWT_SECRET=
PGRST_DB_URI=
# Canais (WhatsApp): chave mestra dos segredos no banco (openssl rand -hex 32);
# Evolution da plataforma; URL que a Evolution chama (na VPS, pela rede interna:
# http://crm-app:3000). ROLE: all (padrão) | api | worker.
CHANNEL_SECRET_KEY=
EVOLUTION_URL=
EVOLUTION_API_KEY=
CHANNEL_WEBHOOK_BASE_URL=
ROLE=
# Mídia do WhatsApp: pasta num Volume do Easypanel (ex.: /app/data/midia).
# Sem ela, nada é guardado e a transcrição baixa o áudio da Evolution.
# Retenção e paralelismo têm padrão (3 meses, 30 dias, 2, 1).
MEDIA_DIR=
MEDIA_RETENTION_MONTHS=
RAW_RETENTION_DAYS=
WORKER_CONCURRENCY=
TRANSCRIPTION_CONCURRENCY=
# Análise das conversas: debounce (s), teto de espera (s), análises em paralelo por worker.
ANALYSIS_DEBOUNCE_SECONDS=
ANALYSIS_MAX_WAIT_SECONDS=
ANALYSIS_CONCURRENCY=
